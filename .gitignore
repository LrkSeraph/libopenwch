# Build artifacts
*.o
*.d
*.a
*.elf
*.bin
*.hex
*.srec
*.list
*.map
*.out
*.stylecheck

# The vendored WCH BLE stack is a *source* artifact, not a build product: it is
# closed-source and cannot be rebuilt from this repository, so the wildcard
# above must not swallow it.  Same trap as the hand-written nvic.h files below.
!lib/ble/wch/LIBCH58xBLE.a

# Generated linker scripts and IRQ headers
generated.*.ld

# The per-family nvic.h is generated by scripts/irq2nvic_h from irq.json; see
# the IRQ_FILES_* variables in the Makefile.  The core layer's nvic.h files are
# hand-written, so they are negated here: without the negations this wildcard
# silently keeps real source out of the repository.
include/libopenwch/*/nvic.h
!include/libopenwch/qingke/nvic.h
!include/libopenwch/dispatch/nvic.h

lib/*/vector_handlers.c
lib/*/vector_names.c
include/libopencmsis/*/irqhandlers.h

# libopencm3-compatible failure stamps
.stamp_failure_*

# Documentation
doc/html/
doc/*/html/
doc/*/doxy.sourcelist
doc/*/Doxyfile
doc/doxygen-root.log
doc/*/doxygen.log
doc/*/DoxygenLayout_*.xml

# Editors / tooling
compile_commands.json
.cache/
*.orig
*.rej
*.swp
*~
