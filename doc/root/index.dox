/**
@mainpage libopenwch

@tableofcontents

@brief libopencm3-style peripheral drivers for WCH (Qinheng) RISC-V MCUs.

\htmlonly
<div class="libopenwch-hero">
<p class="libopenwch-hero-title">A freestanding driver library for WCH QingKe RISC-V MCUs</p>
<p>libopenwch follows libopencm3 in API style, directory layout, build system,
and code conventions, while adapting the toolchain and startup path to the
bare-metal <code>riscv64-unknown-elf</code> world.</p>
<div class="libopenwch-badges">
<span class="libopenwch-badge">RV32EC / RV32IMAC</span>
<span class="libopenwch-badge">C99, no newlib required</span>
<span class="libopenwch-badge">LGPL-3.0-or-later</span>
<span class="libopenwch-badge">Hardware validation: partial</span>
</div>
</div>
\endhtmlonly

@section home_start Start here

\htmlonly
