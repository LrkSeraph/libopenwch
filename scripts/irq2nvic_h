"""Generate the per-device interrupt files from a JSON description.

Derived from libopencm3's scripts/irq2nvic_h, reworked for RISC-V/QingKe.

Input:  include/libopenwch/<target>/irq.json     (<target> may contain '/')

Outputs:
  include/libopenwch/<target>/nvic.h        IRQ ids, ISR prototypes, counts
  lib/<target>/vector_handlers.c            weak fallback ISRs + vector table
  lib/<target>/vector_names.c               name/description tables
  include/libopencmsis/<target>/irqhandlers.h   CMSIS/EVT name aliases

Why a generated .c rather than libopencm3's single nvic.h: on a QingKe core the
vector table is a plain array of function pointers that must be initialised from
the *symbol addresses* of the weak handlers, and the table lives in its own
output section so the linker can assert its position.  Generating the
initialiser next to the weak definitions keeps both in one translation unit,
which is what makes the weak-alias override work.

Interrupt numbering
-------------------
`index` in irq.json is the true vector-table slot.  Vector slots 0..15 are
reserved for RISC-V exceptions, so external interrupts start at 16 and the PFIC
interrupt id equals the slot number.  `<NAME>_IRQ` is that id, and it is valid
to pass straight to nvic_enable_irq() and to index OPENWCH_VECTOR_SET().

Path handling: the substitutions deliberately do NOT prefix the pattern with
'./' (libopencm3 does, which makes them never match the output of
$(wildcard ...) and silently defeats the dependency), and they carry the whole
relative path so that nested targets such as ch32v/003 work.
"""

import json
import os
import re
import sys

TEMPLATE_NVIC_H = '''/* This file is part of the libopenwch project.
 *
 * It was generated by the irq2nvic_h script from {sourcefile}
 */

#ifndef {includeguard}
#define {includeguard}

/** @defgroup qingke_nvic_defines_irqs Interrupts for {partname_humanreadable}
    @ingroup qingke_nvic_defines

    @{{*/

/*
 * Interrupt ids.  Each value is both the vector table slot and the PFIC
 * interrupt number, so it can be passed directly to nvic_enable_irq().
 */
{irqdefinitions}

/* Number of populated external interrupt slots.  Element 0 of
 * vector_table.handler[] corresponds to vector slot {slot_first}. */
#define OPENWCH_IRQ_COUNT {irqcount}
#define OPENWCH_IRQ_FIRST {slot_first}
#define OPENWCH_IRQ_LAST  {slot_last}

/* Number of entries in the generated descriptor table. */
#define OPENWCH_IRQ_TABLE_SIZE OPENWCH_IRQ_COUNT

/**@}}*/

/** @defgroup qingke_nvic_isrprototypes_{partname_doxygen} Interrupt service routine prototypes for {partname_humanreadable}
    @ingroup qingke_nvic_isrprototypes

    @{{*/

BEGIN_DECLS

{isrprototypes}

END_DECLS

/**@}}*/

#endif
'''

TEMPLATE_VECTOR_HANDLERS_C = '''/* This file is part of the libopenwch project.
 *
 * It was generated by the irq2nvic_h script from {sourcefile}
 *
 * Every handler is weak and aliased to blocking_handler(), so an application
 * overrides one simply by defining a non-weak function of the same name.  The
 * vector table below is initialised from these symbols, so it always picks up
 * whichever definition wins at link time.
 */

/** @defgroup qingke_nvic_isrdecls_{partname_doxygen} Interrupt service routines for {partname_humanreadable}
    @ingroup qingke_nvic_defines

    @{{*/

#include <libopenwch/qingke/vector.h>

/*
 * GCC requires the alias target to be *defined* in the same translation unit
 * as the aliases that point at it, so blocking_handler() lives here rather
 * than in the core layer.  Applications may replace it by defining their own
 * non-weak blocking_handler().
 */
void blocking_handler(void)
{{
	while (1) {{
		;
	}}
}}

{isrdecls}

/*
 * The external-interrupt half of the vector table.  The linker asserts that it
 * lands exactly OPENWCH_VECTOR_EXC_OFFSET bytes into `.vector`.
 */
__attribute__((section(".vector"), used))
vector_table_t vector_table = {{
	.handler = {{
{handlers}
	}},
}};

/**@}}*/
'''

# Device IRQ names, used by openwch_irq_name().
TEMPLATE_VECTOR_NAMES_C = '''/* This file is part of the libopenwch project.
 *
 * It was generated by the irq2nvic_h script from {sourcefile}
 */

#include <libopenwch/qingke/vector.h>

/** @cond */
const char *const openwch_irq_names[] = {{
{names}
}};
/** @endcond */

/** @cond */
const openwch_irq_desc_t openwch_irq_table[] = {{
{descs}
}};
/** @endcond */
'''

TEMPLATE_IRQHANDLERS_H = '''/* This file is part of the libopenwch project.
 *
 * It was generated by the irq2nvic_h script from {sourcefile}
 *
 * Compatibility aliases so that code written against the WCH EVT (or against
 * CMSIS) can keep using <PERIPH>_IRQHandler function names.
 */

#ifndef {includeguard}
#define {includeguard}

{irqhandlers}

#endif
'''


def irq_list(irqs):
    """Normalise the `irqs` member into a sorted list of (index, name)."""
    if isinstance(irqs, dict):
        items = [(int(k), v) for k, v in irqs.items()]
    else:
        items = list(enumerate(irqs))
    return [(i, n) for i, n in items if isinstance(n, str) and n]


def make_parent_dir(filename):
    parent = os.path.dirname(filename)
    if parent and not os.path.isdir(parent):
        os.makedirs(parent)


def normalize(infile):
    """Strip a leading './' so the path substitutions below can match."""
    while infile.startswith('./'):
        infile = infile[2:]
    return infile


def outputs(infile):
    infile = normalize(infile)
    nvic_h = infile.replace('irq.json', 'nvic.h')
    base = infile.replace('include/libopenwch/', 'lib/')
    return (nvic_h,
            base.replace('irq.json', 'vector_handlers.c'),
            base.replace('irq.json', 'vector_names.c'),
            infile.replace('irq.json', 'irqhandlers.h')
                  .replace('/libopenwch/', '/libopencmsis/'))


def convert(infile):
    with open(infile, 'r') as f:
        data = json.load(f)

    irqs = irq_list(data['irqs'])
    if not irqs:
        sys.stderr.write('%s: no interrupts defined\n' % infile)
        sys.exit(1)

    partname_humanreadable = data.get('partname_humanreadable', '')
    partname_doxygen = data.get('partname_doxygen', '')
    includeguard = data.get('includeguard', 'LIBOPENWCH_NVIC_H')

    slot_first = min(i for i, _ in irqs)
    slot_last = max(i for i, _ in irqs)
    irqcount = slot_last - slot_first + 1

    by_slot = dict(irqs)
    # Fill gaps so the array stays dense; gaps map to a reserved no-op.
    names = []
    for slot in range(slot_first, slot_last + 1):
        names.append(by_slot.get(slot, 'openwch_reserved_%d' % slot))

    irqdefinitions = []
    isrprototypes = []
    isrdecls = []
    handler_entries = []
    name_entries = []
    desc_entries = []
    irqhandlers = []

    for offset, (slot, name) in enumerate(zip(range(slot_first, slot_last + 1), names)):
        # Gap slots get a dedicated reserved handler name.
        cname = name if slot in by_slot else name.replace('_isr', '')
        symbol = cname + '_isr'
        if slot in by_slot:
            irqdefinitions.append('#define %s_IRQ %d' % (cname.upper(), slot))
            isrprototypes.append('void %s(void);' % symbol)
            irqhandlers.append('#define %s_IRQHandler %s' % (cname.upper(), symbol))
        isrdecls.append('void %s(void) __attribute__((weak, alias("blocking_handler")));'
                        % symbol)
        handler_entries.append('\t\t%s, /* [%2d] slot %2d %s */'
                               % (symbol, offset, slot,
                                  '' if slot in by_slot else '(reserved)'))
        name_entries.append('\t"%s",' % (name if slot in by_slot else ''))
        desc_entries.append('\t{ %d, %d },' % (slot, offset))

    fields = {
        'sourcefile': infile,
        'partname_humanreadable': partname_humanreadable,
        'partname_doxygen': partname_doxygen,
        'includeguard': includeguard,
        'irqcount': irqcount,
        'slot_first': slot_first,
        'slot_last': slot_last,
        'irqdefinitions': '\n'.join(irqdefinitions),
        'isrprototypes': '\n'.join(isrprototypes),
        'isrdecls': '\n'.join(isrdecls),
        'handlers': '\n'.join(handler_entries),
        'names': '\n'.join(name_entries),
        'descs': '\n'.join(desc_entries),
        'irqhandlers': '\n'.join(irqhandlers),
    }
    # The template above has a literal placeholder line-break bug guard:
    fields['slot_first'] = slot_first

    nvic_h, handlers_c, names_c, irqhandlers_h = outputs(infile)

    for path, template in ((nvic_h, TEMPLATE_NVIC_H),
                           (handlers_c, TEMPLATE_VECTOR_HANDLERS_C),
                           (names_c, TEMPLATE_VECTOR_NAMES_C),
                           (irqhandlers_h, TEMPLATE_IRQHANDLERS_H)):
        make_parent_dir(path)
        with open(path, 'w') as f:
            f.write(template.format(**fields))
        print('  GENHDR  %s' % path)


def remove(infile):
    removed = 0
    for path in outputs(infile):
        if os.path.exists(path):
            os.unlink(path)
            removed += 1
    if removed:
        print('  CLNHDR  %s' % normalize(infile))


def main(argv):
    if len(argv) == 3 and argv[1] == '--remove':
        remove(argv[2])
        return

    if len(argv) != 2:
        sys.stderr.write('usage: %s <path>/irq.json\n' % argv[0])
        sys.stderr.write('       %s --remove <path>/irq.json\n' % argv[0])
        sys.exit(1)

    infile = normalize(argv[1])
    if not os.path.isfile(infile):
        sys.stderr.write('%s: not a file\n' % infile)
        sys.exit(1)
    if not re.match(r'(\./)?include/libopenwch/.+/irq\.json$', infile):
        sys.stderr.write('%s: does not match include/libopenwch/**/irq.json\n' % infile)
        sys.exit(1)

    convert(infile)


if __name__ == '__main__':
    main(sys.argv)
